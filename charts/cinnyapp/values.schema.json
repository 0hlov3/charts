{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cinnyapp values",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "resourceList": {
      "type": "object",
      "description": "Map of resource name (e.g. cpu, memory) to Kubernetes resource quantity.",
      "additionalProperties": { "type": ["string", "number"] }
    },
    "resourceRequirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limits": { "$ref": "#/$defs/resourceList" },
        "requests": { "$ref": "#/$defs/resourceList" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "description": "Enable the Ingress resource." },
        "className": { "type": "string", "description": "IngressClass to use (Kubernetes >=1.18)." },
        "annotations": { "type": "object", "description": "Annotations to add to the Ingress." },
        "hosts": {
          "type": "array",
          "description": "Ingress host definitions.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "host": { "type": "string", "description": "Hostname to route through the Ingress." },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": { "type": "string", "enum": ["Exact", "Prefix", "ImplementationSpecific"] }
                  },
                  "required": ["path"]
                }
              }
            },
            "required": ["host"]
          }
        },
        "tls": {
          "type": "array",
          "description": "TLS configuration for the Ingress (secrets and hostnames).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "secretName": { "type": "string" },
              "hosts": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["secretName"]
          }
        }
      }
    }
  },
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "description": "Container image configuration for Cinny.",
      "properties": {
        "registry": { "type": "string", "minLength": 1, "description": "Container image registry." },
        "repository": { "type": "string", "minLength": 1, "description": "Container image repository for Cinny." },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"], "description": "Image pull policy." },
        "tag": { "type": "string", "description": "Image tag. Defaults to the chart appVersion when empty." }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "description": "Cinny config.json, mounted via ConfigMap when override is true.",
      "properties": {
        "override": { "type": "boolean", "description": "Replace the image's default config.json with one generated from these values." },
        "homeserverList": {
          "type": "array",
          "description": "Homeservers offered on the login screen.",
          "items": { "type": "string", "minLength": 1 }
        },
        "defaultHomeserver": { "type": "integer", "minimum": 0, "description": "Index into homeserverList of the preselected homeserver." },
        "allowCustomHomeservers": { "type": "boolean", "description": "Allow users to enter a homeserver not in homeserverList." }
      }
    },
    "networkpolicies": {
      "type": "object",
      "additionalProperties": false,
      "description": "NetworkPolicy options.",
      "properties": {
        "enabled": { "type": "boolean", "description": "Create NetworkPolicies for the Cinny Pod." }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "description": "ServiceAccount options.",
      "properties": {
        "create": { "type": "boolean", "description": "Whether to create a ServiceAccount." },
        "annotations": { "type": "object", "description": "Annotations to add to the ServiceAccount." },
        "name": { "type": "string", "description": "Name of the ServiceAccount to use. If not set and create is true, a name is generated using the fullname template." }
      }
    },
    "podAnnotations": { "type": "object", "description": "Annotations to add to the Pod metadata." },
    "podSecurityContext": { "type": "object", "description": "Pod-level security context (e.g., fsGroup)." },
    "securityContext": { "type": "object", "description": "Container-level security context (capabilities, runAs*, readOnlyRootFilesystem, etc.)." },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "description": "Kubernetes Service configuration.",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"], "description": "Service type." },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535, "description": "Service and container port for the Cinny web UI." }
      }
    },
    "ingress": { "$ref": "#/$defs/ingress", "description": "Ingress for the Cinny web UI." },
    "resources": { "$ref": "#/$defs/resourceRequirements", "description": "CPU/Memory resource requests/limits for the Cinny container." },
    "nodeSelector": { "type": "object", "description": "Node labels for Pod assignment." },
    "tolerations": {
      "type": "array",
      "description": "Tolerations for taints to schedule on matching nodes.",
      "items": { "type": "object" }
    },
    "affinity": { "type": "object", "description": "Affinity/anti-affinity rules for Pod scheduling." },
    "nameOverride": { "type": "string", "description": "String to partially override chart name." },
    "fullnameOverride": { "type": "string", "description": "String to fully override chart fullname." },
    "imagePullSecrets": {
      "type": "array",
      "description": "imagePullSecrets to use for pulling images (e.g. [{name: my-secret}]).",
      "items": { "type": "object" }
    }
  }
}
