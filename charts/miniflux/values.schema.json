{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "miniflux values",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "switch": {
      "description": "Miniflux boolean option. Rendered as a quoted string; \"1\" or \"0\" recommended.",
      "anyOf": [
        { "type": "boolean" },
        { "type": "integer", "enum": [0, 1] },
        { "type": "string", "enum": ["1", "0", "true", "false", "yes", "no", "on", "off"] }
      ]
    },
    "resourceList": {
      "type": "object",
      "description": "Map of resource name (e.g. cpu, memory) to Kubernetes resource quantity.",
      "additionalProperties": { "type": ["string", "number"] }
    },
    "resourceRequirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limits": { "$ref": "#/$defs/resourceList" },
        "requests": { "$ref": "#/$defs/resourceList" },
        "claims": {
          "type": "array",
          "description": "Dynamic resource claims (Kubernetes 1.26+) used by the container.",
          "items": {
            "type": "object",
            "properties": { "name": { "type": "string", "minLength": 1 } },
            "required": ["name"]
          }
        }
      }
    },
    "probe": {
      "type": "object",
      "description": "Kubernetes Probe object. Set to {} to disable the probe."
    }
  },
  "properties": {
    "global": { "type": "object", "description": "Global values shared with parent and sibling charts." },
    "nameOverride": { "type": "string", "description": "String to partially override chart name." },
    "fullnameOverride": { "type": "string", "description": "String to fully override chart fullname." },
    "imagePullSecrets": {
      "type": "array",
      "description": "imagePullSecrets to use for pulling images (e.g. [{name: my-secret}]).",
      "items": { "type": "object" }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "description": "Container image configuration for Miniflux.",
      "properties": {
        "registry": { "type": "string", "minLength": 1, "description": "Container image registry." },
        "repository": { "type": "string", "minLength": 1, "description": "Container image repository." },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"], "description": "Image pull policy." },
        "tag": { "type": "string", "description": "Image tag. Defaults to the chart appVersion when empty." }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": false,
      "description": "Miniflux environment settings. The database URL and admin credentials are read from the Secrets miniflux-db-creds and miniflux-admin-creds.",
      "properties": {
        "RUN_MIGRATIONS": { "$ref": "#/$defs/switch", "description": "Run database migrations on startup." },
        "CREATE_ADMIN": { "$ref": "#/$defs/switch", "description": "Create the admin user on startup." },
        "BASE_URL": {
          "type": "string",
          "pattern": "^(https?://.+)?$",
          "description": "Public base URL (e.g. https://rss.example.com). Defaults to http://localhost when empty."
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "description": "Database credentials.",
      "properties": {
        "existingSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1, "description": "Existing Secret holding the PostgreSQL connection URL." },
            "key": { "type": "string", "minLength": 1, "description": "Key inside the Secret holding the connection URL." }
          },
          "required": ["name", "key"]
        }
      }
    },
    "admin": {
      "type": "object",
      "additionalProperties": false,
      "description": "Admin user credentials, used when env.CREATE_ADMIN is enabled.",
      "properties": {
        "existingSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1, "description": "Existing Secret holding the admin credentials." },
            "usernameKey": { "type": "string", "minLength": 1, "description": "Key inside the Secret holding the admin username." },
            "passwordKey": { "type": "string", "minLength": 1, "description": "Key inside the Secret holding the admin password." }
          },
          "required": ["name", "usernameKey", "passwordKey"]
        }
      }
    },
    "extraEnv": {
      "type": "array",
      "description": "Additional Kubernetes EnvVar objects for the Miniflux container (e.g. TRUSTED_REVERSE_PROXY_NETWORKS, OAUTH2_*). See https://miniflux.app/docs/configuration.html",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "not": { "enum": ["DATABASE_URL", "DATABASE_URL_FILE", "RUN_MIGRATIONS", "CREATE_ADMIN", "ADMIN_USERNAME", "ADMIN_USERNAME_FILE", "ADMIN_PASSWORD", "ADMIN_PASSWORD_FILE", "BASE_URL", "PORT", "LISTEN_ADDR"] },
            "description": "Variable name. Variables managed by the chart (database, admin, BASE_URL) and the listen address (PORT, LISTEN_ADDR; use service.port) are not allowed."
          },
          "value": { "type": "string", "description": "Plain value. Quote numbers and booleans." },
          "valueFrom": { "type": "object", "description": "Source for the value (secretKeyRef, configMapKeyRef, fieldRef, resourceFieldRef)." }
        },
        "required": ["name"],
        "not": { "required": ["value", "valueFrom"] }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "description": "ServiceAccount options.",
      "properties": {
        "create": { "type": "boolean", "description": "Whether to create a ServiceAccount." },
        "automount": { "type": "boolean", "description": "Automount the ServiceAccount token." },
        "annotations": { "type": "object", "description": "Annotations to add to the ServiceAccount." },
        "name": { "type": "string", "description": "Name of the ServiceAccount to use. If not set and create is true, a name is generated using the fullname template." }
      }
    },
    "podAnnotations": { "type": "object", "description": "Annotations to add to the Pod metadata." },
    "podLabels": { "type": "object", "description": "Labels to add to the Pod metadata." },
    "podSecurityContext": { "type": "object", "description": "Pod-level security context." },
    "securityContext": { "type": "object", "description": "Container-level security context." },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "description": "Kubernetes Service configuration.",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"], "description": "Service type." },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535, "description": "Service port. Also used as the container port." }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "description": "Ingress for the Miniflux web UI.",
      "properties": {
        "enabled": { "type": "boolean", "description": "Enable the Ingress resource." },
        "className": { "type": "string", "description": "IngressClass to use." },
        "annotations": { "type": "object", "description": "Annotations to add to the Ingress." },
        "hosts": {
          "type": "array",
          "description": "Ingress host definitions.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "host": { "type": "string", "description": "Hostname to route through the Ingress." },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": { "type": "string", "enum": ["Exact", "Prefix", "ImplementationSpecific"], "description": "Ingress path type (required by networking.k8s.io/v1)." }
                  },
                  "required": ["path", "pathType"]
                }
              }
            },
            "required": ["host"]
          }
        },
        "tls": {
          "type": "array",
          "description": "TLS configuration for the Ingress (secrets and hostnames).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "secretName": { "type": "string" },
              "hosts": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "description": "Gateway API HTTPRoute for the Miniflux web UI.",
      "properties": {
        "enabled": { "type": "boolean", "description": "Create an HTTPRoute (requires Gateway API CRDs)." },
        "annotations": { "type": "object", "description": "Annotations to add to the HTTPRoute." },
        "parentRefs": {
          "type": "array",
          "description": "Gateways this route attaches to.",
          "items": {
            "type": "object",
            "properties": { "name": { "type": "string", "minLength": 1 } },
            "required": ["name"]
          }
        },
        "hostnames": {
          "type": "array",
          "description": "Hostnames matching the HTTP Host header.",
          "items": { "type": "string" }
        },
        "rules": {
          "type": "array",
          "description": "Route rules. Each rule gets a backendRef to the Miniflux Service.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "matches": { "type": "array", "items": { "type": "object" } },
              "filters": { "type": "array", "items": { "type": "object" } }
            }
          }
        }
      }
    },
    "resources": { "$ref": "#/$defs/resourceRequirements", "description": "CPU/Memory resource requests/limits for the Miniflux container." },
    "livenessProbe": { "$ref": "#/$defs/probe" },
    "readinessProbe": { "$ref": "#/$defs/probe" },
    "volumes": {
      "type": "array",
      "description": "Extra volumes for the Deployment.",
      "items": { "type": "object" }
    },
    "volumeMounts": {
      "type": "array",
      "description": "Extra volumeMounts for the Miniflux container.",
      "items": { "type": "object" }
    },
    "nodeSelector": { "type": "object", "description": "Node labels for Pod assignment." },
    "tolerations": {
      "type": "array",
      "description": "Tolerations for taints to schedule on matching nodes.",
      "items": { "type": "object" }
    },
    "affinity": { "type": "object", "description": "Affinity/anti-affinity rules for Pod scheduling." }
  }
}
