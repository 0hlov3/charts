{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "linkwarden values",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "resourceList": {
      "type": "object",
      "description": "Map of resource name (e.g. cpu, memory) to Kubernetes resource quantity.",
      "additionalProperties": { "type": ["string", "number"] }
    },
    "resourceRequirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limits": { "$ref": "#/$defs/resourceList" },
        "requests": { "$ref": "#/$defs/resourceList" },
        "claims": {
          "type": "array",
          "description": "Dynamic resource claims (Kubernetes 1.26+) used by the container.",
          "items": {
            "type": "object",
            "properties": { "name": { "type": "string", "minLength": 1 } },
            "required": ["name"]
          }
        }
      }
    },
    "probe": {
      "type": "object",
      "description": "Kubernetes Probe object. Set to {} to disable the probe."
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "description": "Enable the Ingress resource." },
        "className": { "type": "string", "description": "IngressClass to use." },
        "annotations": { "type": "object", "description": "Annotations to add to the Ingress." },
        "hosts": {
          "type": "array",
          "description": "Ingress host definitions.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "host": { "type": "string", "description": "Hostname to route through the Ingress." },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": { "type": "string", "enum": ["Exact", "Prefix", "ImplementationSpecific"], "description": "Ingress path type." }
                  },
                  "required": ["path"]
                }
              }
            },
            "required": ["host"]
          }
        },
        "tls": {
          "type": "array",
          "description": "TLS configuration for the Ingress (secrets and hostnames).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "secretName": { "type": "string" },
              "hosts": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  },
  "properties": {
    "global": { "type": "object", "description": "Global values shared with parent and sibling charts." },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "description": "Container image configuration for Linkwarden.",
      "properties": {
        "registry": { "type": "string", "minLength": 1, "description": "Container image registry." },
        "repository": { "type": "string", "minLength": 1, "description": "Container image repository for Linkwarden." },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"], "description": "Image pull policy." },
        "tag": { "type": "string", "description": "Image tag. Defaults to the chart appVersion when empty." }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": false,
      "description": "Linkwarden environment configuration.",
      "properties": {
        "nextauth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "minLength": 1, "description": "NEXTAUTH_URL: base URL for NextAuth.js authentication endpoints." },
            "secret": { "type": "string", "description": "NEXTAUTH_SECRET in plain text. Ignored when existingSecret.name and existingSecret.key are set." },
            "existingSecret": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string", "description": "Name of an existing Secret holding NEXTAUTH_SECRET." },
                "key": { "type": "string", "description": "Key inside the existing Secret holding NEXTAUTH_SECRET." }
              }
            }
          }
        }
      }
    },
    "extraEnv": {
      "type": "array",
      "description": "Additional Kubernetes EnvVar objects appended to the Linkwarden container.",
      "items": {
        "type": "object",
        "properties": { "name": { "type": "string", "minLength": 1 } },
        "required": ["name"]
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "description": "Persistent storage for /data/data. Uses an emptyDir when disabled.",
      "properties": {
        "enabled": { "type": "boolean", "description": "Create and mount a PersistentVolumeClaim." },
        "size": { "type": "string", "minLength": 1, "description": "Requested storage size (e.g. 1Gi)." },
        "accessMode": { "type": "string", "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"], "description": "PVC access mode." },
        "storageClassName": { "type": "string", "description": "StorageClass to use. Empty uses the cluster default." }
      }
    },
    "externalPostgresql": {
      "type": "object",
      "additionalProperties": false,
      "description": "External PostgreSQL database (required; the chart fails to render when disabled). Each field can be read from existingSecret instead of the plain value.",
      "properties": {
        "enabled": { "type": "boolean", "description": "Use an external PostgreSQL database. Must be true." },
        "host": { "type": "string", "description": "Database host." },
        "port": { "type": "string", "pattern": "^[0-9]+$", "description": "Database port, as a quoted string (e.g. \"5432\")." },
        "database": { "type": "string", "description": "Database name." },
        "username": { "type": "string", "description": "Database username." },
        "password": { "type": "string", "description": "Database password." },
        "existingSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "description": "Name of an existing Secret containing database settings." },
            "keys": {
              "type": "object",
              "additionalProperties": false,
              "description": "Keys inside the existing Secret. Empty keys fall back to the plain values above.",
              "properties": {
                "host": { "type": "string" },
                "port": { "type": "string" },
                "database": { "type": "string" },
                "username": { "type": "string" },
                "password": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "description": "Kubernetes Service configuration.",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"], "description": "Service type." },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535, "description": "Service port." }
      }
    },
    "ingress": { "$ref": "#/$defs/ingress", "description": "Ingress for the Linkwarden web UI." },
    "imagePullSecrets": {
      "type": "array",
      "description": "imagePullSecrets to use for pulling images (e.g. [{name: my-secret}]).",
      "items": { "type": "object" }
    },
    "nameOverride": { "type": "string", "description": "String to partially override chart name." },
    "fullnameOverride": { "type": "string", "description": "String to fully override chart fullname." },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "description": "ServiceAccount options.",
      "properties": {
        "create": { "type": "boolean", "description": "Whether to create a ServiceAccount." },
        "automount": { "type": "boolean", "description": "Automount the ServiceAccount token." },
        "annotations": { "type": "object", "description": "Annotations to add to the ServiceAccount." },
        "name": { "type": "string", "description": "Name of the ServiceAccount to use. If not set and create is true, a name is generated using the fullname template." }
      }
    },
    "podAnnotations": { "type": "object", "description": "Annotations to add to the Pod metadata." },
    "podLabels": { "type": "object", "description": "Labels to add to the Pod metadata." },
    "podSecurityContext": { "type": "object", "description": "Pod-level security context." },
    "securityContext": { "type": "object", "description": "Container-level security context." },
    "resources": { "$ref": "#/$defs/resourceRequirements", "description": "CPU/Memory resource requests/limits for the Linkwarden container." },
    "livenessProbe": { "$ref": "#/$defs/probe" },
    "readinessProbe": { "$ref": "#/$defs/probe" },
    "volumes": {
      "type": "array",
      "description": "Additional volumes for the Deployment.",
      "items": { "type": "object" }
    },
    "volumeMounts": {
      "type": "array",
      "description": "Additional volumeMounts for the Linkwarden container.",
      "items": { "type": "object" }
    },
    "nodeSelector": { "type": "object", "description": "Node labels for Pod assignment." },
    "tolerations": {
      "type": "array",
      "description": "Tolerations for taints to schedule on matching nodes.",
      "items": { "type": "object" }
    },
    "affinity": { "type": "object", "description": "Affinity/anti-affinity rules for Pod scheduling." }
  }
}
