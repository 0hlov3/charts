{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "etherpad values",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "stringOrInteger": { "type": ["string", "integer"], "pattern": "^[0-9]+$" },
    "numberish": { "type": ["string", "number"] },
    "resourceList": {
      "type": "object",
      "description": "Map of resource name (e.g. cpu, memory) to Kubernetes resource quantity.",
      "additionalProperties": { "type": ["string", "number"] }
    },
    "resourceRequirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limits": { "$ref": "#/$defs/resourceList" },
        "requests": { "$ref": "#/$defs/resourceList" },
        "claims": {
          "type": "array",
          "description": "Dynamic resource claims (Kubernetes 1.26+) used by the container.",
          "items": {
            "type": "object",
            "properties": { "name": { "type": "string", "minLength": 1 } },
            "required": ["name"]
          }
        }
      }
    },
    "probe": {
      "type": "object",
      "description": "Kubernetes Probe object."
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "description": "Enable the Ingress resource." },
        "className": { "type": "string", "description": "IngressClass to use (Kubernetes >=1.18)." },
        "annotations": { "type": "object", "description": "Annotations to add to the Ingress." },
        "hosts": {
          "type": "array",
          "description": "Ingress host definitions.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "host": { "type": "string", "description": "Hostname to route through the Ingress." },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": { "type": "string", "enum": ["Exact", "Prefix", "ImplementationSpecific"], "description": "Ingress path type." }
                  },
                  "required": ["path"]
                }
              }
            },
            "required": ["host"]
          }
        },
        "tls": {
          "type": "array",
          "description": "TLS configuration for the Ingress (secrets and hostnames).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "secretName": { "type": "string" },
              "hosts": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  },
  "properties": {
    "global": { "type": "object", "description": "Global values shared with parent and sibling charts." },
    "replicaCount": { "type": "integer", "minimum": 0, "description": "Number of Etherpad pod replicas to run." },
    "imagePullSecrets": {
      "type": "array",
      "description": "imagePullSecrets to use for pulling images (e.g. [{name: my-secret}]).",
      "items": { "type": "object" }
    },
    "nameOverride": { "type": "string", "description": "String to partially override chart name." },
    "fullnameOverride": { "type": "string", "description": "String to fully override chart fullname." },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "description": "Container image configuration for Etherpad.",
      "properties": {
        "repository": { "type": "string", "minLength": 1, "description": "Etherpad container image repository." },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"], "description": "Image pull policy." },
        "tag": { "type": "string", "description": "Image tag. Defaults to the chart appVersion when empty." }
      }
    },
    "etherpad": {
      "type": "object",
      "additionalProperties": false,
      "description": "Etherpad settings, rendered as environment variables for the official Docker image's settings.json.",
      "properties": {
        "general": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": { "type": "string", "description": "Name of the Etherpad instance." },
            "favicon": { "type": "string", "description": "Favicon name or URL (\"null\" for the default)." },
            "defaultPadText": { "type": "string", "description": "Default text of a newly created pad." },
            "ip": { "type": "string", "minLength": 1, "description": "IP address Etherpad binds to." },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535, "description": "TCP port Etherpad listens on inside the container." },
            "admin": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "password": { "type": "string", "description": "Plain-text admin password. Empty skips creating the admin user." },
                "existingSecret": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": { "type": "boolean", "description": "Read ADMIN_PASSWORD from an existing Secret." },
                    "secretName": { "type": "string", "minLength": 1, "description": "Name of the existing Secret." },
                    "secretKey": { "type": "string", "minLength": 1, "description": "Key inside the Secret holding the admin password." }
                  }
                }
              }
            },
            "userPassword": { "type": "string", "description": "Plain-text password for the built-in \"user\" account. Empty skips creating it." }
          }
        },
        "padOptions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "NoColors": { "type": "boolean" },
            "showControls": { "type": "boolean" },
            "showChat": { "type": "boolean" },
            "showLineNumbers": { "type": "boolean" },
            "useMonospaceFont": { "type": "boolean" },
            "userName": { "type": ["string", "boolean"], "description": "Default display name for anonymous users, or false to disable." },
            "userColor": { "type": ["string", "boolean"], "description": "Default authorship color for anonymous users, or false to disable." },
            "rtl": { "type": "boolean" },
            "alwaysShowChat": { "type": "boolean" },
            "chatAndUsers": { "type": "boolean" },
            "lang": { "type": "string", "minLength": 1, "description": "Default UI language (e.g. en-gb)." },
            "lowercasePadIDs": { "type": "boolean" }
          }
        },
        "shortcuts": {
          "type": "object",
          "description": "Enable/disable individual pad editor keyboard shortcuts.",
          "additionalProperties": false,
          "properties": {
            "enabledAltF9": { "type": "boolean" },
            "enabledAltC": { "type": "boolean" },
            "enabledCmdS": { "type": "boolean" },
            "enabledCmdZ": { "type": "boolean" },
            "enabledCmdY": { "type": "boolean" },
            "enabledCmdI": { "type": "boolean" },
            "enabledCmdB": { "type": "boolean" },
            "enabledCmdU": { "type": "boolean" },
            "enabledCmdH": { "type": "boolean" },
            "enabledCmd5": { "type": "boolean" },
            "enabledCmdShift1": { "type": "boolean" },
            "enabledCmdShift2": { "type": "boolean" },
            "enabledCmdShiftL": { "type": "boolean" },
            "enabledCmdShiftN": { "type": "boolean" },
            "enabledCmdShiftC": { "type": "boolean" },
            "enabledDELETE": { "type": "boolean" },
            "enabledRETURN": { "type": "boolean" },
            "enabledESC": { "type": "boolean" },
            "enabledTAB": { "type": "boolean" },
            "enabledCTRLHOME": { "type": "boolean" },
            "enabledPAGEUP": { "type": "boolean" },
            "enabledPAGEDOWN": { "type": "boolean" }
          }
        },
        "skins": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "skinName": { "type": "string", "minLength": 1, "description": "Skin to use: no-skin, colibris, or a directory under src/static/skins." },
            "skinVariants": { "type": "string", "description": "Space-separated list of skin variants (colibris only)." }
          }
        },
        "logging": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "logLevel": { "type": "string", "enum": ["DEBUG", "INFO", "WARN", "ERROR"], "description": "Server log verbosity." },
            "disableIPLogging": { "type": "boolean", "description": "Deprecated: true maps to ipLogging=anonymous, false to full. Ignored when ipLogging is set." },
            "ipLogging": { "type": "string", "enum": ["", "anonymous", "truncated", "full"], "description": "Client IP logging mode. Empty derives it from disableIPLogging." }
          }
        },
        "cookie": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "keyRotationInterval": { "$ref": "#/$defs/stringOrInteger", "description": "Cookie signing key rotation interval in milliseconds." },
            "sameSite": { "type": "string", "enum": ["Lax", "Strict", "None"], "description": "SameSite cookie attribute." },
            "sessionLifetime": { "$ref": "#/$defs/stringOrInteger", "description": "Session cookie lifetime in milliseconds." },
            "sessionRefreshInterval": { "$ref": "#/$defs/stringOrInteger", "description": "Session cookie refresh interval in milliseconds." }
          }
        },
        "advanced": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "showSettingsInAdminPage": { "type": "boolean" },
            "authenticationMethod": { "type": "string", "enum": ["sso", "apikey"], "description": "Server authentication method." },
            "trustProxy": { "type": "boolean" },
            "importMaxFileSize": { "$ref": "#/$defs/stringOrInteger", "description": "Maximum import file size in bytes." },
            "importExportMaxReqPerIp": { "$ref": "#/$defs/stringOrInteger" },
            "importExportRateLimitWindow": { "$ref": "#/$defs/stringOrInteger", "description": "Import/export rate-limit window in milliseconds." },
            "commitRateLimitDuration": { "$ref": "#/$defs/stringOrInteger", "description": "Commit rate-limit window in seconds." },
            "commitRateLimitPoints": { "$ref": "#/$defs/stringOrInteger" },
            "suppressErrorsInPadText": { "type": "boolean" },
            "requireSession": { "type": "boolean" },
            "editOnly": { "type": "boolean" },
            "minify": { "type": "boolean" },
            "maxAge": { "$ref": "#/$defs/stringOrInteger", "description": "Client cache lifetime for served JavaScript in seconds." },
            "soffice": { "type": ["string", "null"], "description": "Absolute path to the soffice (LibreOffice) executable, or null to disable." },
            "docxExport": { "type": "boolean" },
            "tidyHTML": { "description": "Deprecated and unused; kept for values-file compatibility." },
            "allowUnknownFileEnds": { "type": "boolean" },
            "requireAuthentication": { "type": "boolean" },
            "requireAuthorization": { "type": "boolean" },
            "automaticReconnectionTimeout": { "$ref": "#/$defs/numberish", "description": "Seconds before automatic reconnection; 0 disables it." },
            "focusLinePercentageAbove": { "$ref": "#/$defs/numberish" },
            "focusLinePercentageBelow": { "$ref": "#/$defs/numberish" },
            "focusLinePercentageArrowUp": { "$ref": "#/$defs/numberish" },
            "focusLineDuration": { "$ref": "#/$defs/numberish" },
            "focusLineCaretScroll": { "type": "boolean" },
            "socketioMaxHttpBufferSize": { "$ref": "#/$defs/stringOrInteger", "description": "Maximum Socket.IO message size in bytes." },
            "loadTest": { "type": "boolean", "description": "Never enable in production." },
            "dumpOnUncleanExit": { "type": "boolean" },
            "exposeVersion": { "type": "boolean" }
          }
        }
      }
    },
    "externalPostgresql": {
      "type": "object",
      "additionalProperties": false,
      "description": "Externally managed PostgreSQL database. Mutually exclusive with postgresql.enabled.",
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string", "description": "Hostname of the external PostgreSQL server." },
        "port": { "$ref": "#/$defs/stringOrInteger", "description": "TCP port of the external PostgreSQL server." },
        "database": { "type": "string" },
        "username": { "type": "string", "description": "Ignored when existingSecret is set." },
        "password": { "type": "string", "description": "Ignored when existingSecret is set." },
        "existingSecret": { "type": "string", "description": "Existing Secret holding the database username/password." },
        "existingSecretUsernameKey": { "type": "string" },
        "existingSecretPasswordKey": { "type": "string" },
        "useConnectionString": { "type": "boolean", "description": "Unsupported; must stay false (the chart fails to render when true)." }
      }
    },
    "postgresql": {
      "type": "object",
      "description": "Bundled Bitnami PostgreSQL subchart values. Only the keys used by this chart are validated; everything else is passed to the subchart.",
      "properties": {
        "enabled": { "type": "boolean", "description": "Deploy the bundled PostgreSQL subchart. Mutually exclusive with externalPostgresql.enabled." },
        "auth": {
          "type": "object",
          "properties": {
            "username": { "type": "string" },
            "database": { "type": "string" },
            "existingSecret": { "type": "string" }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "description": "ServiceAccount options.",
      "properties": {
        "create": { "type": "boolean", "description": "Whether to create a ServiceAccount." },
        "annotations": { "type": "object", "description": "Annotations to add to the ServiceAccount." },
        "name": { "type": "string", "description": "Name of the ServiceAccount to use. If not set and create is true, a name is generated using the fullname template." }
      }
    },
    "podAnnotations": { "type": "object", "description": "Annotations to add to the Pod metadata." },
    "podSecurityContext": { "type": "object", "description": "Pod-level security context." },
    "securityContext": { "type": "object", "description": "Container-level security context." },
    "extraEnv": {
      "type": "array",
      "description": "Additional Kubernetes EnvVar objects appended to the Etherpad container.",
      "items": {
        "type": "object",
        "properties": { "name": { "type": "string", "minLength": 1 } },
        "required": ["name"]
      }
    },
    "startupProbe": { "$ref": "#/$defs/probe" },
    "readinessProbe": { "$ref": "#/$defs/probe" },
    "livenessProbe": { "$ref": "#/$defs/probe" },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "description": "Kubernetes Service configuration.",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"], "description": "Service type." },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535, "description": "Service port Etherpad is exposed on." }
      }
    },
    "ingress": { "$ref": "#/$defs/ingress", "description": "Ingress for the Etherpad web UI." },
    "resources": { "$ref": "#/$defs/resourceRequirements", "description": "CPU/Memory resource requests/limits for the Etherpad container." },
    "nodeSelector": { "type": "object", "description": "Node labels for Pod assignment." },
    "tolerations": {
      "type": "array",
      "description": "Tolerations for taints to schedule on matching nodes.",
      "items": { "type": "object" }
    },
    "affinity": { "type": "object", "description": "Affinity/anti-affinity rules for Pod scheduling." }
  }
}
